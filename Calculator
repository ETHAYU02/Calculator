<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scientific Calculator</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #f2f2f2;
        }

        .calculator {
            width: 420px;
            padding: 20px;
            background: #222;
            border-radius: 18px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.3);
        }

        #display {
            width: 100%;
            height: 75px;
            margin-bottom: 15px;
            padding: 10px 15px;
            font-size: 30px;
            text-align: right;
            border: none;
            border-radius: 10px;
            background: white;
            color: #111;
        }

        .buttons {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
        }

        button {
            height: 55px;
            border: none;
            border-radius: 9px;
            font-size: 18px;
            cursor: pointer;
            background: #444;
            color: white;
        }

        button:hover {
            background: #555;
        }

        .function {
            background: #555;
        }

        .operator {
            background: #ff9500;
        }

        .operator:hover {
            background: #e68900;
        }

        .clear {
            background: #d9534f;
        }

        .equal {
            background: #28a745;
        }

        .constant {
            background: #6c757d;
        }

        .wide {
            grid-column: span 2;
        }
    </style>
</head>

<body>

<div class="calculator">

    <input type="text" id="display" value="0" disabled>

    <div class="buttons">

        <!-- Scientific Functions -->
        <button class="function" onclick="scientific('sin')">sin</button>
        <button class="function" onclick="scientific('cos')">cos</button>
        <button class="function" onclick="scientific('tan')">tan</button>
        <button class="function" onclick="scientific('log')">log</button>
        <button class="function" onclick="scientific('ln')">ln</button>

        <button class="function" onclick="squareRoot()">√</button>
        <button class="function" onclick="square()">x²</button>
        <button class="function" onclick="addOperator('^')">xʸ</button>
        <button class="function" onclick="factorial()">x!</button>
        <button class="function" onclick="scientific('abs')">|x|</button>

        <!-- Controls -->
        <button class="clear" onclick="clearDisplay()">AC</button>
        <button onclick="deleteLast()">⌫</button>
        <button onclick="percentage()">%</button>
        <button class="constant" onclick="addNumber('π')">π</button>
        <button class="constant" onclick="addNumber('e')">e</button>

        <!-- Numbers -->
        <button onclick="addNumber('7')">7</button>
        <button onclick="addNumber('8')">8</button>
        <button onclick="addNumber('9')">9</button>
        <button class="operator" onclick="addOperator('/')">÷</button>
        <button onclick="addNumber('(')">(</button>

        <button onclick="addNumber('4')">4</button>
        <button onclick="addNumber('5')">5</button>
        <button onclick="addNumber('6')">6</button>
        <button class="operator" onclick="addOperator('*')">×</button>
        <button onclick="addNumber(')')">)</button>

        <button onclick="addNumber('1')">1</button>
        <button onclick="addNumber('2')">2</button>
        <button onclick="addNumber('3')">3</button>
        <button class="operator" onclick="addOperator('-')">−</button>
        <button class="function" onclick="scientific('exp')">eˣ</button>

        <button class="wide" onclick="addNumber('0')">0</button>
        <button onclick="addNumber('.')">.</button>
        <button class="operator" onclick="addOperator('+')">+</button>
        <button class="equal" onclick="calculate()">=</button>

    </div>
</div>


<script>

    let display = document.getElementById("display");
    let currentInput = "";

    // Add numbers/constants
    function addNumber(value) {

        if (currentInput === "Error") {
            currentInput = "";
        }

        if (value === "π") {
            currentInput += "Math.PI";
        }
        else if (value === "e") {
            currentInput += "Math.E";
        }
        else {
            currentInput += value;
        }

        display.value = currentInput;
    }


    // Add operators
    function addOperator(operator) {

        if (currentInput === "" || currentInput === "Error") {
            return;
        }

        let lastChar = currentInput.slice(-1);

        if ("+-*/^".includes(lastChar)) {
            currentInput = currentInput.slice(0, -1);
        }

        currentInput += operator;

        display.value = currentInput;
    }


    // Clear
    function clearDisplay() {

        currentInput = "";
        display.value = "0";
    }


    // Delete last character
    function deleteLast() {

        if (currentInput === "Error") {
            clearDisplay();
            return;
        }

        currentInput = currentInput.slice(0, -1);

        display.value = currentInput || "0";
    }


    // Convert degree to radian
    function toRadians(degree) {
        return degree * Math.PI / 180;
    }


    // Scientific functions
    function scientific(type) {

        if (currentInput === "" || currentInput === "Error") {
            return;
        }

        try {

            let value = eval(
                currentInput
                    .replace(/\^/g, "**")
            );

            let result;

            switch (type) {

                case "sin":
                    result = Math.sin(toRadians(value));
                    break;

                case "cos":
                    result = Math.cos(toRadians(value));
                    break;

                case "tan":
                    result = Math.tan(toRadians(value));
                    break;

                case "log":
                    result = Math.log10(value);
                    break;

                case "ln":
                    result = Math.log(value);
                    break;

                case "abs":
                    result = Math.abs(value);
                    break;

                case "exp":
                    result = Math.exp(value);
                    break;
            }

            currentInput = String(result);
            display.value = currentInput;

        } catch {

            display.value = "Error";
            currentInput = "Error";
        }
    }


    // Square root
    function squareRoot() {

        if (currentInput === "" || currentInput === "Error") {
            return;
        }

        try {

            let value = eval(
                currentInput.replace(/\^/g, "**")
            );

            let result = Math.sqrt(value);

            if (!isFinite(result)) {
                throw new Error();
            }

            currentInput = String(result);
            display.value = currentInput;

        } catch {

            display.value = "Error";
            currentInput = "Error";
        }
    }


    // Square
    function square() {

        if (currentInput === "" || currentInput === "Error") {
            return;
        }

        try {

            let value = eval(
                currentInput.replace(/\^/g, "**")
            );

            let result = value * value;

            currentInput = String(result);
            display.value = currentInput;

        } catch {

            display.value = "Error";
            currentInput = "Error";
        }
    }


    // Factorial
    function factorial() {

        if (currentInput === "" || currentInput === "Error") {
            return;
        }

        try {

            let value = eval(
                currentInput.replace(/\^/g, "**")
            );

            if (value < 0 || !Number.isInteger(value)) {
                throw new Error();
            }

            let result = 1;

            for (let i = 2; i <= value; i++) {
                result *= i;
            }

            currentInput = String(result);
            display.value = currentInput;

        } catch {

            display.value = "Error";
            currentInput = "Error";
        }
    }


    // Percentage
    function percentage() {

        if (currentInput === "" || currentInput === "Error") {
            return;
        }

        try {

            let value = eval(
                currentInput.replace(/\^/g, "**")
            );

            currentInput = String(value / 100);
            display.value = currentInput;

        } catch {

            display.value = "Error";
            currentInput = "Error";
        }
    }


    // Calculate
    function calculate() {

        if (currentInput === "" || currentInput === "Error") {
            return;
        }

        try {

            let expression = currentInput
                .replace(/π/g, "Math.PI")
                .replace(/\^/g, "**");

            let result = eval(expression);

            if (!isFinite(result)) {
                throw new Error();
            }

            currentInput = String(result);
            display.value = result;

        } catch {

            display.value = "Error";
            currentInput = "Error";
        }
    }


    // Keyboard support
    document.addEventListener("keydown", function(event) {

        if (
            (event.key >= "0" && event.key <= "9") ||
            event.key === "."
        ) {
            addNumber(event.key);
        }

        else if ("+-*/^".includes(event.key)) {
            addOperator(event.key);
        }

        else if (event.key === "Enter" || event.key === "=") {
            calculate();
        }

        else if (event.key === "Backspace") {
            deleteLast();
        }

        else if (event.key === "Escape") {
            clearDisplay();
        }

        else if (event.key === "%") {
            percentage();
        }

    });

</script>

</body>
</html>



Thank You!
